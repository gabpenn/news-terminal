{
  "name": "news-terminal",
  "main": "src/worker.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },
  "triggers": { "crons": ["* * * * *", "*/2 * * * *"] },
  "vars": {
    "BOARD_FEED_URL": "https://media26.bechirot.gov.il/files/expc.csv"
  }
}
